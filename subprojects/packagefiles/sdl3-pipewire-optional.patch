--- a/src/audio/meson.build
+++ b/src/audio/meson.build
@@ -7,10 +7,59 @@
   cdata.set('SDL_AUDIO_DRIVER_COREAUDIO', 1)
   subdir('coreaudio')
 else
-  cdata.set('SDL_AUDIO_DRIVER_PIPEWIRE', 1)
-  subdir('pipewire')
+  # PipeWire is the only audio driver this port builds on Linux, and it is
+  # not optional upstream: without the -dev package the build fails on a
+  # missing pipewire/pipewire.h. Gate it on the dependency actually being
+  # present so SDL still builds (with no audio driver) elsewhere.
+  if pipewire_dep.found()
+    cdata.set('SDL_AUDIO_DRIVER_PIPEWIRE', 1)
+    subdir('pipewire')
+  endif
+
+  # ALSA and PulseAudio, which this port left out entirely -- it built
+  # PipeWire and nothing else, so a machine without the PipeWire -dev package
+  # ended up with no way to make a sound. Both are loaded by name at runtime
+  # rather than linked, which is how distributions ship SDL: the headers are
+  # needed to build, the shared object only has to be present to play.
+  alsa_dep = dependency('alsa', required: false)
+  if alsa_dep.found()
+    cdata.set('SDL_AUDIO_DRIVER_ALSA', 1)
+    cdata.set_quoted('SDL_AUDIO_DRIVER_ALSA_DYNAMIC', 'libasound.so.2')
+    sdl_deps += alsa_dep.partial_dependency(compile_args: true, includes: true)
+    subdir('alsa')
+  endif
+
+  pulse_dep = dependency('libpulse-simple', required: false)
+  if not pulse_dep.found()
+    pulse_dep = dependency('libpulse', required: false)
+  endif
+  if pulse_dep.found()
+    cdata.set('SDL_AUDIO_DRIVER_PULSEAUDIO', 1)
+    cdata.set_quoted('SDL_AUDIO_DRIVER_PULSEAUDIO_DYNAMIC', 'libpulse.so.0')
+    sdl_deps += pulse_dep.partial_dependency(compile_args: true, includes: true)
+    subdir('pulseaudio')
+  endif
+
+  # Say so loudly. With no real backend SDL falls back to the dummy driver,
+  # where opening a device, creating tracks and playing all succeed and the
+  # result is silence -- a failure with no symptom except a silent game, and
+  # nothing in the build output to explain it.
+  if not (pipewire_dep.found() or alsa_dep.found() or pulse_dep.found())
+    warning('No Linux audio backend found (PipeWire, ALSA or PulseAudio). ' +
+            'SDL3 will be built with only the dummy driver and the game ' +
+            'will have no sound. Install libasound2-dev or libpulse-dev.')
+  endif
 endif
 
+# The dummy and disk drivers have no external dependencies and upstream always
+# builds them. Without them a build that finds no real backend has no audio
+# driver at all, which makes SDL_AUDIODRIVER=dummy -- the usual way to run
+# headless or in CI -- impossible.
+cdata.set('SDL_AUDIO_DRIVER_DUMMY', 1)
+subdir('dummy')
+cdata.set('SDL_AUDIO_DRIVER_DISK', 1)
+subdir('disk')
+
 sources += files(

@@ -309,7 +309,13 @@
   cdata.set('SDL_TIMER_UNIX', 1)
   sdl_deps += dependency('libudev')
   sdl_deps += dependency('dbus-1')
-  sdl_deps += dependency('libpipewire-0.3')
+  # PipeWire is one audio backend among several; SDL builds fine without it
+  # and picks ALSA or PulseAudio instead. Requiring it unconditionally makes
+  # the subproject unbuildable anywhere the -dev package is absent.
+  pipewire_dep = dependency('libpipewire-0.3', required: false)
+  if pipewire_dep.found()
+    sdl_deps += pipewire_dep
+  endif
   sdl_deps += dependency('wayland-client')
   sdl_deps += dependency('wayland-egl')
   sdl_deps += dependency('wayland-cursor')
@@ -456,7 +462,14 @@
   input: 'include/build_config/SDL_build_config.h.cmake',
   output: 'SDL_build_config.h',
   configuration: cdata,
-  format: 'cmake',
+  # 'cmake@', not 'cmake'. The template substitutes with @VAR@ throughout (35
+  # of them, no ${VAR} anywhere), and only the cmake@ format expands that form.
+  # Plain 'cmake' leaves lines like
+  #     #cmakedefine SDL_AUDIO_DRIVER_ALSA_DYNAMIC @SDL_AUDIO_DRIVER_ALSA_DYNAMIC@
+  # half-substituted on the meson versions that do not expand @VAR@ here,
+  # emitting a literal @ into a C header. Newer meson happens to expand it
+  # either way, which is why this only failed on some machines.
+  format: 'cmake@',
 )
 

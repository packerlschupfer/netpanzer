# SDL3, SDL3_ttf and SDL3_mixer are built from the wraps in subprojects/
# rather than taken from the archive: libsdl3-mixer-dev exists only in
# unstable and requires libsdl3-dev (>= 3.4.0), while trixie carries 3.2.10,
# so packaging against the archive would mean pulling SDL3 out of unstable.
# The tarballs are in subprojects/packagecache, so the build needs no network.
# What follows is therefore SDL3's own build dependencies, not this game's.
 libasound2-dev,
 libdbus-1-dev,
 libegl-dev,
 libfreetype-dev,
 libpulse-dev,
 libudev-dev,
 libwayland-dev,
 libxkbcommon-dev,
 wayland-protocols
